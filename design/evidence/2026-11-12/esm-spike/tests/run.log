=== Part A: 递归 import 解析 ===

入口: app.mjs
去重后共 4 个模块

依赖图（箭头表示 import 关系，下游先）:
  utils.mjs  (叶子)
  state.mjs  <- [utils.mjs]
  views.mjs  <- [utils.mjs]
  app.mjs  <- [state.mjs, views.mjs]

--- 源码块（按拓扑顺序） ---

>>> FILE: utils.mjs
// utils.mjs — 叶子模块，state 和 views 都依赖它
export function formatActivityName(raw) {
  if (!raw) return '';
  return raw.trim().replace(/\s+/g, ' ');
}

export function padDate(d) {
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${d.getFullYear()}-${m}-${day}`;
}

export const VERSION = '1.0.0';
<<< END

>>> FILE: state.mjs
// state.mjs — 模拟产品 state 模块，管理活动列表
import { formatActivityName, VERSION } from './utils.mjs';

const activities = [];

export function addActivity(raw) {
  const name = formatActivityName(raw?.name);
  if (!name) return null;
  const item = { id: activities.length + 1, name, signed: false };
  activities.push(item);
  return item;
}

export function listActivities() {
  return activities.slice();
}

export function getStateVersion() {
  return VERSION;
}
<<< END

>>> FILE: views.mjs
// views.mjs — 模拟产品 views 模块，操作 DOM
import { formatActivityName } from './utils.mjs';

export function renderCards(container, items) {
  if (!container) return 0;
  container.innerHTML = '';
  let count = 0;
  for (const item of items) {
    const div = document.createElement('div');
    div.className = 'card';
    div.dataset.id = String(item.id);
    div.textContent = formatActivityName(item.name);
    container.appendChild(div);
    count++;
  }
  return count;
}

export function showTitle(text) {
  const el = document.getElementById('app-title');
  if (el) el.textContent = text;
}
<<< END

>>> FILE: app.mjs
// app.mjs — 入口模块
import { addActivity, listActivities, getStateVersion } from './state.mjs';
import { renderCards, showTitle } from './views.mjs';

export function init() {
  // 构造几块假数据
  addActivity({ name: '  春季运动会 ' });
  addActivity({ name: '  学术讲座  ' });

  // 操作 DOM
  document.body.innerHTML = '<h1 id="app-title"></h1><div id="card-root"></div>';
  showTitle('活动列表 v' + getStateVersion());

  const root = document.getElementById('card-root');
  const count = renderCards(root, listActivities());

  // 返回一个结构化结果供断言
  return {
    activityCount: count,
    titleText: document.getElementById('app-title')?.textContent || '',
    bodyHTML: document.body.innerHTML,
  };
}
<<< END

