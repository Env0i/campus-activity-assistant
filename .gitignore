# 配置文件：见 server/config.example.json；含推送 webhook / 密钥，属于这台机器，不入库
config.json
server/config.json
local/config.json

# 运行时数据：token、会话、浏览器登录态、抓取结果、机器人去重缓存
data/
server/data/
local/data/
bot/data/
server/bot/data/

# 生成物：日报和结构化结果跑一次就变，不入库
reports/
server/reports/

# 构建产物：模板 zip 按需重新打包
dist/
server/dist/

# AI 工具的本地配置与流程产物：只对这台机器有意义，一律不入库
# （Windows 路径大小写不敏感，但 git 在别的系统上按大小写匹配，所以两种写法都写）
.claude/
.Claude/
.Codex/
.codex/

# 外部二进制：cloudflared 等由用户侧自带或按需下载，五十多兆的可执行文件不入库
local/bin/
bin/cloudflared.exe

# 依赖与 Python 字节码
node_modules/
__pycache__/
*.py[cod]

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp

# 原始视觉证据含验证码或本机临时路径，保留本地，不加入版本库。
