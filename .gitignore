# 配置文件：见 server/config.example.json；含推送 webhook / 密钥，属于这台机器，不入库
config.json
server/config.json
local/config.json

# 构建时生成的站点地址：tools/release.py 在 prepare 阶段按构建环境 SCHOOL_ORIGIN 写出，
# 含真实域名，绝不入库；源码态没有这个文件属正常。
local/_site_build.py

# 运行时数据：token、会话、浏览器登录态、抓取结果、机器人去重缓存
data/
server/data/
local/data/
bot/data/
server/bot/data/

# 生成物：日报和结构化结果跑一次就变，不入库
reports/
server/reports/

# 构建产物：模板 zip 按需重新打包
dist/
server/dist/

# AI 工具的本地配置与流程产物：只对这台机器有意义，一律不入库
# （Windows 路径大小写不敏感，但 git 在别的系统上按大小写匹配，所以两种写法都写）
.claude/
.Claude/
.Codex/
.codex/
# superpowers 过程施工单草稿：只对本机协作有意义，不入正式 docs/ 文档树
/docs/superpowers/plans/

# 外部二进制：cloudflared 等由用户侧自带或按需下载，五十多兆的可执行文件不入库
local/bin/
bin/cloudflared.exe

# 依赖与 Python 字节码
node_modules/
__pycache__/
*.py[cod]

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.swp

# 证据目录下的报告台账（README.md 等）和复现脚本正常入库；截图二进制图片（png/jpg/webp）
# 留在本地不入库，防止仓库历史持续膨胀（历史已追踪截图不受本规则回溯影响）。
/design/evidence/2026-11-04/ui-gap/
/design/evidence/**/*.png
/design/evidence/**/*.jpg
/design/evidence/**/*.webp

# Trae 导出的原型分享包（本机生成，不入库）
.trae-html-share-packages/

# aoci MCP 的宿主配置：命令与仓库路径是本机绝对路径，换机器即失效，不入库
/.mcp.json
